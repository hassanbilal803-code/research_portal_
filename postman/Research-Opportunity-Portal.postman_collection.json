    {
      "name": "04 Retrieve all opportunities",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "description": "04 Retrieve all opportunities. Run requests in order; IDs come from the actual MySQL responses."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const records = pm.response.json();",
              "pm.test('Response is a list', () => pm.expect(records).to.be.an('array'));",
              "pm.test('All three created records are in MySQL', () => [1, 2, 3].forEach(n => pm.expect(records.some(r => String(r.id) === pm.collectionVariables.get('opportunityId' + n))).to.eql(true)));"
            ]
          }
        }
      ]

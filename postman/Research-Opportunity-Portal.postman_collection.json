{
  "info": {
    "name": "Research Opportunity Portal - Hassan Bilal - Python and MySQL",
    "description": "P229072 Hassan Bilal. Run once, in order, with Python and MySQL running. Covers every TA-required Postman demonstration. The last two requests optionally clean up this run's remaining records. No account or environment credentials are required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "opportunityId1",
      "value": "",
      "type": "string"
    },
    {
      "key": "opportunityId2",
      "value": "",
      "type": "string"
    },
    {
      "key": "opportunityId3",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Create opportunity 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/opportunities",
        "description": "01 Create opportunity 1. Run requests in order; IDs come from the actual MySQL responses.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Wireless Coverage Study\",\n  \"description\": \"Study campus network performance and identify congestion patterns.\",\n  \"research_area\": \"Computer Networks\",\n  \"faculty_name\": \"Dr. Omar Saeed\",\n  \"department\": \"Computer Science\",\n  \"required_skills\": \"Python, Wireshark, TCP/IP\",\n  \"available_positions\": 3,\n  \"application_deadline\": \"2027-06-30\",\n  \"status\": \"Open\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "[1, 2, 3].forEach(n => pm.collectionVariables.unset('opportunityId' + n));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const record = pm.response.json();",
              "pm.test('MySQL generated an ID', () => pm.expect(record.id).to.be.a('number').above(0));",
              "pm.test('Created record has all fields', () => pm.expect(record).to.have.keys('id', 'title', 'description', 'research_area', 'faculty_name', 'department', 'required_skills', 'available_positions', 'application_deadline', 'status', 'created_at', 'updated_at'));",
              "pm.test('Opportunity is open', () => pm.expect(record.status).to.eql('Open'));",
              "if (pm.response.code === 201 && Number.isInteger(record.id)) pm.collectionVariables.set('opportunityId1', String(record.id));"
            ]
          }
        }
      ]
    },
